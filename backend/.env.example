NODE_ENV=development
PORT=4000

# Database (use DATABASE_URL or discrete variables)
DATABASE_URL=mysql://ssms_user:ssms_password@127.0.0.1:3306/ssms
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ssms
# DB_USER=ssms_user
# DB_PASSWORD=ssms_password

JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=15m

# Comma-separated allowed origins (first is primary for CORS + cookies)
FRONTEND_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=12

# Rate limits (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
